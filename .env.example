# ── Application ──────────────────────────────────────────────
APP_ENV=local                # local | hackathon | prod
APP_NAME=trusted-enterprise-agent

# ── Database (docker-compose default) ────────────────────────
DATABASE_URL=postgresql+psycopg://tea:tea@db:5432/tea

# ── LLM provider (Stage 1: anthropic | bedrock, one switch) ──
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AWS_REGION=eu-central-1
