# ── Application ──────────────────────────────────────────────
APP_ENV=local                # local | hackathon | prod
APP_NAME=trusted-enterprise-agent

# ── Database (docker-compose default) ────────────────────────
DATABASE_URL=postgresql+psycopg://tea:tea@db:5432/tea

# ── LLM provider switch: anthropic | bedrock ─────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Anthropic API model cascade
LLM_FAST_MODEL=claude-haiku-4-5-20251001
LLM_SMART_MODEL=claude-sonnet-5

# AWS Bedrock (verify exact model IDs in the console on-site)
AWS_REGION=eu-central-1
BEDROCK_FAST_MODEL_ID=anthropic.claude-haiku-4-5-v1:0
BEDROCK_SMART_MODEL_ID=anthropic.claude-sonnet-5-v1:0

# ── PII pseudonymization ─────────────────────────────────────
# HMAC key fixing the original->fake mapping (KMS in production)
PII_SECRET_KEY=change-me-before-the-event

# ── Guardrails ───────────────────────────────────────────────
# Enable the optional LLM injection-classifier layer (heuristics always on)
GUARDRAILS_USE_LLM=false

# ── CORS (JSON list; Angular dev server by default) ──────────
CORS_ORIGINS=["http://localhost:4200"]
